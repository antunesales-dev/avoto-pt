# Copiar para .env (nunca commitar .env)
# Local: após `supabase start`, use `supabase status -o env`

VITE_SUPABASE_URL=http://127.0.0.1:55421
VITE_SUPABASE_ANON_KEY=

# Cloudflare Turnstile (anti-bot no Entrar)
# Dashboard: https://dash.cloudflare.com → Turnstile → Add site
# Site key = pública (Vite); Secret = só na edge Supabase
VITE_TURNSTILE_SITE_KEY=

# Stripe Payment Link (doações — MB WAY/cartão no Checkout se activos na conta Stripe)
# Dashboard Stripe → Payment Links → copiar URL https://buy.stripe.com/...
VITE_STRIPE_PAYMENT_LINK_URL=

# Nunca expor no frontend:
# SUPABASE_SERVICE_ROLE_KEY=
# TURNSTILE_SECRET_KEY=   → supabase secrets set TURNSTILE_SECRET_KEY=...
# STRIPE_SECRET_KEY / STRIPE_WEBHOOK_SECRET → só edge stripe-webhook
