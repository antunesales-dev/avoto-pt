# Copiar para .env e preencher. Nunca commitar .env.
# (Valores reais só em variáveis de ambiente locais / CI secrets / Cloudflare / Supabase.)

# Supabase (fase seguinte)
# VITE_SUPABASE_URL=https://xxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=

# Público — nunca a service_role key no frontend
# SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare (deploy / wrangler)
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
