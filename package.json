{
  "name": "avoto",
  "version": "0.0.1",
  "description": "A Voto — Bancada Cidadã. Plataforma neutra e open source para comparar a vontade dos cidadãos com o voto dos partidos na Assembleia da República.",
  "productName": "A Voto — Bancada Cidadã",
  "author": "antunesales-dev <antunesales.developer@gmail.com>",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "quasar dev",
    "dev:pwa": "quasar dev -m pwa",
    "build": "quasar build -m pwa && node scripts/prerender-meta.mjs dist/pwa",
    "build:spa": "quasar build && node scripts/prerender-meta.mjs dist/spa",
    "test": "node --test tests/*.test.mjs scripts/tests/*.test.mjs scripts/*.test.mjs seo/*.test.mjs",
    "test:deno": "deno test -A supabase/functions/tests/ supabase/functions/_shared/",
    "postinstall": "quasar prepare --silent",
    "deploy": "pnpm build && wrangler pages deploy dist/pwa --project-name=avoto-pt --branch=main",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:status": "supabase status",
    "db:push": "supabase db push",
    "fn:deploy": "supabase functions deploy health && supabase functions deploy ar-sync && supabase functions deploy daily-digest && supabase functions deploy despesa-sync && supabase functions deploy request-otp && supabase functions deploy delete-my-account",
    "fn:serve": "supabase functions serve",
    "sync:ar": "node scripts/sync-ar.mjs --limit=all",
    "sync:ar:50": "node scripts/sync-ar.mjs --limit=50",
    "sync:digests": "node scripts/generate-digests.mjs",
    "sync:textos": "node scripts/extract-textos-ar.mjs --limit=150",
    "sync:links": "node scripts/link-comunicados.mjs --days=14",
    "test:comunicados": "deno test -A supabase/functions/tests/ && node --test scripts/tests/*.test.mjs"
  },
  "dependencies": {
    "@quasar/extras": "^2.0.0",
    "@supabase/supabase-js": "^2.112.0",
    "pinia": "^4.0.2",
    "quasar": "^2.32.2",
    "vue": "^3.5.42",
    "vue-router": "^5.0.6",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@quasar/app-vite": "^3.3.0",
    "autoprefixer": "^10.4.27",
    "postcss": "^8.5.8",
    "wrangler": "^4.118.0"
  },
  "pnpm": {
    "overrides": {
      "undici": "8.12.3",
      "nanoid": "3.3.18",
      "sharp": "0.35.5",
      "vite@>=8.2.0 <8.2.4": "8.2.4",
      "source-map-js@>=1.0.0 <1.2.2": "1.2.2",
      "serialize-javascript@<7.1.3": "7.1.4"
    }
  },
  "keywords": [
    "quasar",
    "quasar-app",
    "quasar-cli",
    "quasar-app-vite",
    "vite",
    "vue",
    "vuejs"
  ],
  "engines": {
    "node": ">= 26 || ^24 || ^22.12"
  },
  "license": "AGPL-3.0-only"
}
