{
  "name": "avoto",
  "version": "0.0.1",
  "description": "A Voto — Bancada Cidadã. Plataforma neutra e open source para comparar a vontade dos cidadãos com o voto dos partidos na Assembleia da República.",
  "productName": "A Voto — Bancada Cidadã",
  "author": "antunesales-dev <antunesales.developer@gmail.com>",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "quasar dev",
    "dev:pwa": "quasar dev -m pwa",
    "build": "quasar build -m pwa",
    "build:spa": "quasar build",
    "postinstall": "quasar prepare --silent",
    "deploy": "pnpm build && wrangler pages deploy dist/pwa --project-name=avoto-pt --branch=main",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:status": "supabase status",
    "db:push": "supabase db push",
    "fn:deploy": "supabase functions deploy health && supabase functions deploy ar-sync && supabase functions deploy daily-digest && supabase functions deploy despesa-sync",
    "fn:serve": "supabase functions serve",
    "sync:ar": "node scripts/sync-ar.mjs --limit=all",
    "sync:ar:50": "node scripts/sync-ar.mjs --limit=50",
    "sync:digests": "node scripts/generate-digests.mjs"
  },
  "dependencies": {
    "@quasar/extras": "^2.0.0",
    "@supabase/supabase-js": "^2.112.0",
    "pinia": "^4.0.2",
    "quasar": "^2.23.3",
    "vue": "^3.5.22",
    "vue-router": "^5.0.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@quasar/app-vite": "^3.3.0",
    "autoprefixer": "^10.4.27",
    "postcss": "^8.5.8",
    "wrangler": "^4.118.0"
  },
  "keywords": [
    "quasar",
    "quasar-app",
    "quasar-cli",
    "quasar-app-vite",
    "vite",
    "vue",
    "vuejs"
  ],
  "engines": {
    "node": ">= 26 || ^24 || ^22.12"
  },
  "license": "AGPL-3.0-only"
}
