# CSP em header complementa a do <meta> em index.html (o meta nao suporta frame-ancestors).
# Sem default-src aqui: so restringe estas 4 directivas; scripts/estilos continuam no meta.
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()
  Strict-Transport-Security: max-age=31536000
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'

# HTML sempre fresco (novos hashes de chunks)
/
  Cache-Control: no-cache, must-revalidate

/index.html
  Cache-Control: no-cache, must-revalidate

# Assets com hash: cache longo (só quando o ficheiro existe de verdade)
/assets/*
  Cache-Control: public, max-age=31536000, immutable
